{
  "name": "k1blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node --env-file-if-exists=.env.local --import tsx scripts/content/check-content.ts && node --env-file-if-exists=.env.local --import tsx scripts/build/build-search-index.ts && node --env-file-if-exists=.env.local --import tsx scripts/db/migrate.ts",
    "dev": "next dev",
    "prebuild": "node --env-file-if-exists=.env.local --import tsx scripts/content/check-content.ts && node --env-file-if-exists=.env.local --import tsx scripts/build/build-search-index.ts",
    "build": "next build",
    "postbuild": "node scripts/build/build-admin-bootstrap.mjs && node scripts/build/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/dev/start-local.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env.local --import tsx scripts/dev/test-e2e-setup.ts && playwright test",
    "content:check": "node --env-file-if-exists=.env.local --import tsx scripts/content/check-content.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db/migrate.ts",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/db/check-db.ts",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db/backup-db.mjs",
    "comments:purge": "node --env-file-if-exists=.env.local scripts/db/purge-comments.mjs",
    "admin:bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/db/bootstrap-admin.ts",
    "search:index": "node --env-file-if-exists=.env.local --import tsx scripts/build/build-search-index.ts",
    "fonts:build": "python scripts/fonts/build-display-font.py",
    "lighthouse": "lhci autorun",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "@orama/tokenizers": "3.1.18",
    "better-auth": "1.7.14",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "gray-matter": "4.0.3",
    "next": "16.4.3",
    "next-mdx-remote-client": "2.1.12",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-pretty-code": "0.14.5",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
