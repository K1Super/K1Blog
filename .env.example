BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
COMMENT_IP_PEPPER=replace-with-a-random-string-at-least-32-characters

SMTP_URL=
SMTP_FROM=

ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
